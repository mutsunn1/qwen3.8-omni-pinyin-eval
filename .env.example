# ---------------------------------------------------------------------------
# pinyin-eval 本地环境变量（复制为 .env 后填写；.env 已被 gitignore）
#
#   cp .env.example .env
#   uv run pinyin-eval check     # 确认是否检测到凭证
#
# 也可以不用 .env，直接 export 同名环境变量（shell 变量优先于 .env）。
# ---------------------------------------------------------------------------

# 阿里云百炼 API Key（北京/新加坡地域不同，按使用地域填写）
DASHSCOPE_API_KEY=

# 百炼业务空间 OpenAI 兼容地址，形如：
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 不同地域地址不同；留空则回退到公共兼容地址
#   https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# 可选：默认配置文件路径（等价于命令行 --config）
# PINYIN_EVAL_CONFIG=configs/base.yaml
